# ============================================================================
# Docker Ignore File
# ============================================================================
# Files and directories to exclude from Docker build context
# This reduces build time and image size
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
README.md
LICENSE
docs/
history/
specs/

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/

# Environment
.env
.env.local
.env.*.local
*.env

# Testing
coverage/
*.test.js
*.spec.js

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Kubernetes and deployment
k8s/
helm/
docker-compose*.yml

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Temporary files
tmp/
temp/
*.tmp
