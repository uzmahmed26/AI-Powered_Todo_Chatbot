# API Configuration
VITE_API_URL=http://localhost:8000

# Better Auth Configuration
VITE_BETTER_AUTH_URL=https://your-auth-domain.com

# Application Configuration
VITE_APP_NAME="Smart Todo ChatKit"
VITE_APP_ENV=development

# Google Translate API Configuration
# Get your API key from: https://console.cloud.google.com
# 1. Create a new project or select existing
# 2. Enable "Cloud Translation API"
# 3. Go to Credentials → Create API Key
# 4. Copy the key and paste below
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
VITE_GOOGLE_PROJECT_ID=your_google_cloud_project_id
