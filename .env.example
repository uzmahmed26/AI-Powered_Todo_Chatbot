# Phase III Smart Todo ChatKit App - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration (Neon Serverless PostgreSQL)
# ============================================================================
# Get your connection string from: https://console.neon.tech/
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-1.aws.neon.tech/smarttodo?sslmode=require

# ============================================================================
# OpenAI Configuration
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
MAX_CONTEXT_MESSAGES=20

# ============================================================================
# Better Auth Configuration
# ============================================================================
BETTER_AUTH_SECRET=your-secure-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=https://your-auth-domain.com

# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=development
LOG_LEVEL=INFO

# ============================================================================
# Backend API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================================================
# Frontend Configuration
# ============================================================================
VITE_API_URL=http://localhost:8000
VITE_BETTER_AUTH_URL=https://your-auth-domain.com
VITE_APP_NAME=Smart Todo ChatKit
VITE_APP_ENV=development

# ============================================================================
# MCP Server Configuration
# ============================================================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# ============================================================================
# Multi-language Support (Bonus Feature)
# ============================================================================
SUPPORTED_LANGUAGES=en,ur

# ============================================================================
# Cloud Deployment Blueprints (Bonus Feature)
# ============================================================================
BLUEPRINT_OUTPUT_DIR=/tmp/blueprints
BLUEPRINT_EXPIRY_HOURS=24
