# Vercel Ignore File
# Files and directories to exclude from Vercel deployment

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/venv/
backend/env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Testing
.coverage
htmlcov/
.pytest_cache/

# Build artifacts (keep for deployment)
# frontend/dist/ - DON'T ignore, needed for deployment

# Documentation
docs/
*.md
!README.md
!DEPLOYMENT.md

# Specs and history (not needed in production)
specs/
history/
.specify/
.claude/

# Git
.git/
.gitignore
.gitattributes

# Database
*.db
*.sqlite
*.sqlite3

# Alembic (migrations run separately)
backend/alembic/

# Tests
backend/tests/
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
frontend/src/**/*.spec.ts
frontend/src/**/*.spec.tsx
